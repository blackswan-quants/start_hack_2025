   "source": [
    "import os\n",
    "import rasterio\n",
    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "import matplotlib.colors as colors\n",
    "\n",
    "def visualize_precipitation_pif_folder(folder_path):\n",
    "    \"\"\"\n",
    "    Visualizes Precipitation Intensity Factor (PIF) data from multiple raster files in a folder\n",
    "    with proper geographical context.\n",
    "\n",
    "    Parameters:\n",
    "        folder_path (str): The folder path containing .tif files for each year of precipitation data.\n",
    "    \"\"\"\n",
    "    # Loop through all .tif files in the folder\n",
    "    tif_files = [f for f in os.listdir(folder_path) if f.endswith('.tif')]\n",
    "    tif_files.sort()  # Assumiamo che il nome contenga l'anno\n",
    "\n",
    "    for tif_file in tif_files:\n",
    "        tif_file_path = os.path.join(folder_path, tif_file)\n",
    "        \n",
    "        try:\n",
    "            with rasterio.open(tif_file_path) as src:\n",
    "                pif_data = src.read(1)\n",
    "                \n",
    "                # Applica la maschera se esiste un valore NoData\n",
    "                if src.nodata is not None:\n",
    "                    mask = pif_data == src.nodata\n",
    "                    pif_data = np.ma.masked_array(pif_data, mask=mask)\n",
    "                \n",
    "                # Estrai l'anno dal nome del file\n",
    "                year = tif_file.split('_')[-1].split('.')[0]\n",
    "                \n",
    "                if pif_data.mask.all() or np.all(pif_data == 0):\n",
    "                    print(f\"⚠️ Nessun dato valido in {tif_file}. File saltato.\")\n",
    "                    continue\n",
    "\n",
    "                valid_data = pif_data[pif_data > 0]\n",
    "                if valid_data.size == 0:\n",
    "                    print(f\"⚠️ Nessun dato positivo in {tif_file}. File saltato.\")\n",
    "                    continue\n",
    "\n",
    "                vmin = np.nanmin(valid_data)\n",
    "                vmax = np.nanmax(pif_data)\n",
    "                \n",
    "                # Creazione della figura e impostazione dell'extent geografico\n",
    "                fig, ax = plt.subplots(figsize=(12, 10))\n",
    "                norm = colors.Normalize(vmin=vmin, vmax=vmax)\n",
    "                extent = [src.bounds.left, src.bounds.right, src.bounds.bottom, src.bounds.top]\n",
    "                \n",
    "                # Visualizza i dati utilizzando imshow()\n",
    "                img = ax.imshow(pif_data, cmap='Blues', norm=norm, extent=extent)\n",
    "                ax.set_title(f'Precipitation Intensity Factor (PIF) - {year}', fontsize=16)\n",
    "                ax.set_xlabel('Longitude', fontsize=12)\n",
    "                ax.set_ylabel('Latitude', fontsize=12)\n",
    "                ax.grid(True, linestyle='--', alpha=0.5)\n",
    "                \n",
    "                # Aggiunge la colorbar\n",
    "                cbar = plt.colorbar(img, ax=ax, extend='max', shrink=0.8)\n",
    "                cbar.set_label('Precipitation Intensity Factor (PIF)', fontsize=12)\n",
    "                \n",
    "                # Visualizza le informazioni sul CRS\n",
    "                plt.figtext(0.1, 0.01, f\"CRS: {src.crs}\", fontsize=8)\n",
    "                \n",
    "                plt.tight_layout()\n",
    "                plt.show()\n",
    "                \n",
    "                # Stampa delle statistiche\n",
    "                print(f\"📊 Statistiche per {tif_file}:\")\n",
    "                print(f\"   - Min: {np.nanmin(pif_data)}\")\n",
    "                print(f\"   - Max: {np.nanmax(pif_data)}\")\n",
    "                print(f\"   - Media: {np.nanmean(pif_data)}\")\n",
    "                print(f\"   - Deviazione standard: {np.nanstd(pif_data)}\")\n",
    "                print(\"---------------------------------------------\")\n",
    "        except Exception as e:\n",
    "            print(f\"❌ Errore durante l'elaborazione di {tif_file}: {e}\")\n",
    "\n",
    "# Esempio di utilizzo\n",
    "folder_path = 'data/Climate_Precipitation_Data'\n",
    "visualize_precipitation_pif_folder(folder_path)"
   ]
  },
