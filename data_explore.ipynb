    "import os\n",
    "import geopandas as gpd\n",
    "import matplotlib.pyplot as plt\n",
    "import xml.etree.ElementTree as ET\n",
    "\n",
    "def read_aux_xml_shp(shp_path):\n",
    "    \"\"\"\n",
    "    Legge il file ausiliario (.shp.aux.xml) associato a shp_path e restituisce un dizionario con le statistiche.\n",
    "    Si assume che il file ausiliario abbia lo stesso nome del shapefile, con estensione \".shp.aux.xml\".\n",
    "    \"\"\"\n",
    "    base, _ = os.path.splitext(shp_path)\n",
    "    aux_path = base + \".shp.aux.xml\"\n",
    "    stats = {}\n",
    "    if os.path.exists(aux_path):\n",
    "        try:\n",
    "            tree = ET.parse(aux_path)\n",
    "            root = tree.getroot()\n",
    "            for mdi in root.findall(\".//Metadata/MDI\"):\n",
    "                key = mdi.get(\"key\")\n",
    "                value = mdi.text.strip() if mdi.text is not None else \"\"\n",
    "                stats[key] = value\n",
    "        except Exception as e:\n",
    "            print(f\"❌ Errore nella lettura di {aux_path}: {e}\")\n",
    "    return stats\n",
    "\n",
    "def plot_mainroad_streamwater_shapefiles(folder_path):\n",
    "    \"\"\"\n",
    "    Itera su tutti i file .shp della cartella e, se il nome contiene \"Main_road\" oppure \"Streamwater\",\n",
    "    visualizza il shapefile e le statistiche lette dal file ausiliario (.shp.aux.xml) se presenti.\n",
    "    \n",
    "    :param folder_path: Cartella contenente i file .shp\n",
    "    \"\"\"\n",
    "    # Filtra i file .shp che contengono \"main_road\" o \"streamwater\" (case insensitive)\n",
    "    shp_files = [f for f in os.listdir(folder_path) if f.lower().endswith('.shp') and \n",
    "                 (\"main_road\" in f.lower() or \"streamwater\" in f.lower())]\n",
    "    \n",
    "    if not shp_files:\n",
    "        print(f\"❌ Nessun file .shp con 'Main_road' o 'Streamwater' trovato in: {folder_path}\")\n",
    "        return\n",
    "\n",
    "    shp_files.sort()\n",
    "\n",
    "    for shp_file in shp_files:\n",
    "        shp_path = os.path.join(folder_path, shp_file)\n",
    "        print(f\"\\n📂 Elaborando: {shp_path}\")\n",
    "        try:\n",
    "            # Carica il file Shapefile con GeoPandas\n",
    "            gdf = gpd.read_file(shp_path)\n",
    "            print(\"Anteprima dati:\")\n",
    "            print(gdf.head())\n",
    "            \n",
    "            # Plot del file Shapefile\n",
    "            fig, ax = plt.subplots(figsize=(10, 6))\n",
    "            gdf.plot(ax=ax, color=\"blue\", edgecolor=\"black\", linewidth=1)\n",
    "            ax.set_title(f\"{shp_file} - Visualizzazione Shapefile\", fontsize=16)\n",
    "            ax.set_xlabel(\"Longitude\", fontsize=12)\n",
    "            ax.set_ylabel(\"Latitude\", fontsize=12)\n",
    "            ax.grid(True, linestyle=\"--\", alpha=0.5)\n",
    "            plt.tight_layout()\n",
    "            plt.show()\n",
    "            \n",
    "            # Legge il file XML ausiliario, se presente, e stampa le statistiche\n",
    "            stats = read_aux_xml_shp(shp_path)\n",
    "            if stats:\n",
    "                print(\"📊 Statistiche lette dall'XML:\")\n",
    "                for key in [\"STATISTICS_MINIMUM\", \"STATISTICS_MAXIMUM\", \"STATISTICS_MEAN\", \n",
    "                            \"STATISTICS_STDDEV\", \"STATISTICS_MEDIAN\", \"STATISTICS_COUNT\"]:\n",
    "                    if key in stats:\n",
    "                        print(f\"   - {key}: {stats[key]}\")\n",
    "            else:\n",
    "                print(\"⚠ Nessun file XML ausiliario trovato per questo shapefile.\")\n",
    "            print(\"-\" * 50)\n",
    "        except Exception as e:\n",
    "            print(f\"❌ Errore durante l'elaborazione di {shp_file}: {e}\")\n",
    "\n",
    "# Esempio di utilizzo:\n",
    "folder_path = \"data/Streamwater_Line_Road_Network\"  # Aggiorna il percorso in base alla struttura della tua cartella\n",
    "plot_mainroad_streamwater_shapefiles(folder_path)"
   ]
