    "import os\n",
    "import rasterio\n",
    "import matplotlib.pyplot as plt\n",
    "import matplotlib.colors as colors\n",
    "import numpy as np\n",
    "import xml.etree.ElementTree as ET\n",
    "\n",
    "def plot_population_density_data(folder_path):\n",
    "    \"\"\"\n",
    "    Plotta i dati dei file .tif presenti in folder_path (Gridded_Population_Density_Data)\n",
    "    e legge i file .tif.aux.xml per mostrare le statistiche.\n",
    "    \n",
    "    :param folder_path: Percorso della cartella contenente i file .tif (e .tif.aux.xml associati)\n",
    "    \"\"\"\n",
    "    tif_files = [f for f in os.listdir(folder_path) if f.lower().endswith('.tif')]\n",
    "    if not tif_files:\n",
    "        print(f\"❌ Nessun file .tif trovato in: {folder_path}\")\n",
    "        return\n",
    "\n",
    "    for tif_file in tif_files:\n",
    "        tif_path = os.path.join(folder_path, tif_file)\n",
    "        aux_xml_path = tif_path + \".aux.xml\"\n",
    "        print(f\"\\n📂 Elaborando: {tif_file}\")\n",
    "        \n",
    "        # Apertura e plot del file raster\n",
    "        try:\n",
    "            with rasterio.open(tif_path) as src:\n",
    "                data = src.read(1)\n",
    "                # Applica la maschera se è definito un valore NoData\n",
    "                if src.nodata is not None:\n",
