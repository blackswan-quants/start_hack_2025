    "import os\n",
    "import rasterio\n",
    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "import matplotlib.colors as colors\n",
    "import xml.etree.ElementTree as ET\n",
    "\n",
    "def read_aux_xml(tif_path):\n",
    "    \"\"\"\n",
    "    Legge il file ausiliario (.tif.aux.xml) associato a tif_path e restituisce un dizionario con le statistiche.\n",
    "    \"\"\"\n",
    "    aux_path = tif_path + \".aux.xml\"\n",
    "    stats = {}\n",
    "    if os.path.exists(aux_path):\n",
    "        try:\n",
    "            tree = ET.parse(aux_path)\n",
    "            root = tree.getroot()\n",
    "            # Cerca i nodi <MDI> all'interno di <Metadata>\n",
    "            for mdi in root.findall(\".//Metadata/MDI\"):\n",
    "                key = mdi.get(\"key\")\n",
    "                value = mdi.text.strip() if mdi.text is not None else \"\"\n",
    "                stats[key] = value\n",
    "        except Exception as e:\n",
    "            print(f\"❌ Errore nella lettura di {aux_path}: {e}\")\n",
    "    return stats\n",
    "\n",
    "def plot_MODIS_GPP_with_stats(folder_path):\n",
    "    \"\"\"\n",
    "    Itera su tutti i file .tif in folder_path, plottando i dati MODIS Gross Primary Production (GPP)\n",
    "    e stampando le statistiche lette dai file .tif.aux.xml (se presenti).\n",
    "    \n",
    "    :param folder_path: Percorso della cartella contenente i file .tif\n",
    "    \"\"\"\n",
    "    tif_files = [f for f in os.listdir(folder_path) if f.lower().endswith('.tif')]\n",
    "    if not tif_files:\n",
    "        print(f\"❌ Nessun file .tif trovato in: {folder_path}\")\n",
    "        return\n",
    "    \n",
    "    tif_files.sort()\n",
    "    \n",
    "    for tif_file in tif_files:\n",
    "        tif_path = os.path.join(folder_path, tif_file)\n",
    "        print(f\"\\n📂 Elaborando: {tif_path}\")\n",
    "        try:\n",
    "            with rasterio.open(tif_path) as src:\n",
    "                data = src.read(1)\n",
    "                # Applica maschera per NoData se definita\n",
    "                if src.nodata is not None:\n",
    "                    data = np.ma.masked_array(data, mask=(data == src.nodata))\n",
    "                \n",
    "                # Calcola l'extent geografico usando i bounds del dataset\n",
    "                extent = [src.bounds.left, src.bounds.right, src.bounds.bottom, src.bounds.top]\n",
    "                \n",
    "                # Normalizzazione dei dati validi\n",
    "                if np.ma.is_masked(data):\n",
    "                    valid_data = data.compressed()\n",
    "                else:\n",
    "                    valid_data = data\n",
    "                if valid_data.size == 0:\n",
    "                    print(f\"⚠️ Nessun dato valido in {tif_file}\")\n",
    "                    continue\n",
    "                vmin = valid_data.min()\n",
    "                vmax = valid_data.max()\n",
    "                norm = colors.Normalize(vmin=vmin, vmax=vmax)\n",
    "                \n",
    "                # Plot dei dati\n",
    "                plt.figure(figsize=(10, 8))\n",
    "                img = plt.imshow(data, cmap='viridis', norm=norm, extent=extent)\n",
    "                cbar = plt.colorbar(img, extend='max')\n",
    "                cbar.set_label(\"GPP\", fontsize=12)\n",
    "                plt.title(f\"MODIS Land Cover Data\\n{tif_file}\", fontsize=16)\n",
    "                plt.xlabel(\"Longitude\", fontsize=12)\n",
    "                plt.ylabel(\"Latitude\", fontsize=12)\n",
    "                plt.grid(True, linestyle='--', alpha=0.5)\n",
    "                plt.tight_layout()\n",
    "                plt.show()\n",
    "                \n",
    "                # Legge il file ausiliario XML e stampa le statistiche\n",
    "                stats = read_aux_xml(tif_path)\n",
    "                if stats:\n",
    "                    print(\"📊 Statistiche lette dall'XML:\")\n",
    "                    for key in [\"STATISTICS_MINIMUM\", \"STATISTICS_MAXIMUM\", \"STATISTICS_MEAN\", \n",
    "                                \"STATISTICS_STDDEV\", \"STATISTICS_MEDIAN\", \"STATISTICS_COUNT\"]:\n",
    "                        if key in stats:\n",
    "                            print(f\"   - {key}: {stats[key]}\")\n",
    "                else:\n",
    "                    print(\"⚠ File XML ausiliario non trovato per questo raster.\")\n",
    "        except Exception as e:\n",
    "            print(f\"❌ Errore durante l'elaborazione del file {tif_file}: {e}\")\n",
    "\n",
    "# Esempio di utilizzo:\n",
    "folder_path = \"data/MODIS_Land_Cover_Data\"\n",
    "plot_MODIS_GPP_with_stats(folder_path)"
   ]
  },
